---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';

const page = site.pages['/faq'];
const crumbs = [{ name: 'FAQ', href: '/faq' }];
---

<Layout title={page.title} description={page.description} image={page.image} crumbs={crumbs} faqs={site.faqs}>
  <PageHeader eyebrow={page.eyebrow} title={page.heading} highlight={page.highlight} intro={page.intro} crumbs={crumbs} />
  <Faq heading={false} />
  <Contact />
</Layout>
