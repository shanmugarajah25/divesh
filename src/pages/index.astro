---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Defs from '../components/Defs.astro';
import Diya from '../components/Diya.astro';
import Divider from '../components/Divider.astro';
import baby from '../assets/baby-murugan.jpg';
import { event } from '../data/event';

const shareText = `${event.babyTaOf} தொட்டில் விழா நினைவுகள்
${event.siteUrl}`;
const whatsapp = `https://wa.me/?text=${encodeURIComponent(shareText)}`;
---

<Layout title={`${event.babyTa} | ${event.babyEn}`} description={`எமது செல்வப் புதல்வன் ${event.babyTa}. ஆசீர்வதித்த அனைவருக்கும் நன்றிகள்.`}>
  <Defs />
  <main class="welcome">
    <div class="toran" aria-hidden="true"></div>

    <div class="art">
      <div class="arch">
        <div class="swing">
          <Image src={baby} alt="Baby Murugan on a flower-decked golden cradle" widths={[300, 460, 640]} sizes="(max-width: 860px) 74vw, 300px" quality={70} loading="eager" />
        </div>
      </div>
      <div class="diyas" aria-hidden="true">
        <Diya delay="0s" /><Diya delay=".4s" /><Diya delay=".8s" />
      </div>
    </div>

    <div class="words">
      <p class="lead">எமது செல்வப் புதல்வன்</p>
      <h1 class="name">
        <span class="name-ta">{event.babyTa}</span>
        <span class="name-en">{event.babyEn}</span>
      </h1>
      <Divider />
      <p class="invite-text">ஆசீர்வதித்த அனைவருக்கும் எமது மனமார்ந்த நன்றிகள்.</p>
      <p class="hosts">{event.hostsTa}</p>

      <nav class="links" aria-label="விரைவு இணைப்புகள்">
        <a class="link-card" href="/thottil-vizha">
          <span class="link-ic" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2.5" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
          </span>
          <span class="link-text">
            <b>தொட்டில் விழா</b>
            <small>{event.dateText}</small>
          </span>
          <svg class="link-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a class="link-card" href={whatsapp} target="_blank" rel="noopener">
          <span class="link-ic" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 20l1.3-4.2A8 8 0 1 1 8.6 19z" /><path d="M9 9.5c.3 2.5 2.5 4.8 5.2 5.4l1.3-1.3-2-1-1 .9c-1-.5-1.9-1.4-2.4-2.4l.9-1-1-2z" /></svg>
          </span>
          <span class="link-text">
            <b>பகிர்க</b>
            <small>WhatsApp</small>
          </span>
          <svg class="link-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </nav>
    </div>

    <footer class="site-foot">
      <p class="vetrivel">வெற்றிவேல் முருகனுக்கு அரோகரா!</p>
      <p class="copy">© {new Date().getFullYear()} {event.hostsEn}</p>
    </footer>
  </main>
</Layout>

<style>
  .welcome {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    min-height: 100vh;
    padding: 96px 20px 48px;
  }
  .art { width: min(300px, 74vw); }
  .links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    width: min(560px, 100%);
    margin: 28px auto 0;
  }
  .link-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px;
    border-radius: 18px;
    text-align: left;
    text-decoration: none;
    color: var(--ink);
    background: rgba(255, 255, 255, 0.75);
    box-shadow: inset 0 0 0 1.5px rgba(200, 150, 46, 0.45), 0 10px 24px -16px rgba(110, 50, 10, 0.5);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .link-card:hover { transform: translateY(-2px); box-shadow: inset 0 0 0 1.5px var(--gold), 0 14px 28px -14px rgba(110, 50, 10, 0.55); }
  .link-card:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }
  .link-ic {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: #ffe9b8;
    background: linear-gradient(180deg, var(--maroon-2), var(--maroon));
  }
  .link-text { flex: 1; min-width: 0; }
  .link-text b { display: block; color: var(--maroon); font-family: var(--ta-display); font-weight: 800; font-size: 1.02rem; line-height: 1.3; }
  .link-text small { display: block; color: var(--muted); font-size: 0.82rem; }
  .link-card svg { fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  .link-ic svg { width: 22px; height: 22px; }
  .link-arrow { flex: none; width: 18px; height: 18px; color: var(--gold-d); }
  .site-foot { margin-top: auto; padding-top: 12px; text-align: center; }
  .copy { margin: 6px 0 0; color: var(--muted); font-size: 0.8rem; }
  @media (max-width: 480px) {
    .links { grid-template-columns: 1fr; }
  }
</style>
