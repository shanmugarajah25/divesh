---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';

const page = site.pages['/work'];
const crumbs = [{ name: 'Work', href: '/work' }];
const projectsLd = {
  '@type': 'ItemList',
  name: 'Selected work by Loncey Tech',
  itemListElement: site.projects.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'CreativeWork',
      name: p.title,
      description: p.description,
      keywords: p.tags.join(', '),
      creator: { '@id': `${Astro.site}#organization` },
      ...(p.links.live ? { url: p.links.live } : {}),
    },
  })),
};
---

<Layout title={page.title} description={page.description} image={page.image} crumbs={crumbs} pageType="CollectionPage" schema={[projectsLd]}>
  <PageHeader eyebrow={page.eyebrow} title={page.heading} highlight={page.highlight} intro={page.intro} crumbs={crumbs} />
  <Projects heading={false} />
  <Contact />
</Layout>
