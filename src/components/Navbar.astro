---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
  <nav class="container-x flex items-center justify-between py-5 transition-all duration-300" aria-label="Primary">
    <a href="/" class="group inline-flex items-center gap-2 font-display text-2xl font-extrabold tracking-tight" aria-label="Home">
      <span class="icon-tile size-9 rounded-xl text-base font-extrabold transition-transform duration-500 group-hover:-rotate-6">R</span>
      <span><span class="grad-text">{site.shortName}</span><span class="text-accent-500">.</span></span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {site.nav.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={['nav-link', isActive(item.href) && 'active']}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <button type="button" class="icon-btn" aria-label="Toggle dark mode" data-theme-toggle>
        <Icon name="ph:sun-bold" size={20} class="hidden dark:inline-block" />
        <Icon name="ph:moon-bold" size={20} class="dark:hidden" />
      </button>
      <a href="/contact" class="btn-primary hidden !py-2.5 lg:inline-flex">
        Hire me
        <Icon name="ph:arrow-right-bold" size={16} />
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="icon-btn menu-toggle lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="menu-bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </nav>
</header>

<!-- Full-screen mobile menu -->
<div id="mobile-menu" class="fixed inset-0 z-40 lg:hidden" aria-hidden="true">
  <div class="menu-backdrop absolute inset-0 bg-bg/85 backdrop-blur-2xl"></div>
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="blob absolute -left-32 top-24 size-80 rounded-full bg-brand-500/30 blur-3xl animate-blob"></div>
    <div class="blob absolute -right-32 bottom-24 size-80 rounded-full bg-accent-500/25 blur-3xl animate-blob [animation-delay:-8s]"></div>
  </div>
  <div class="menu-panel relative flex h-full flex-col overflow-y-auto px-5 pb-8 pt-24 sm:px-8">
    <ul class="flex flex-col gap-1.5">
      {site.nav.map((item, i) => (
        <li class="mobile-item" style={`--i:${i}`}>
          <a
            href={item.href}
            class:list={[
              'mobile-link group flex items-center gap-4 rounded-2xl px-4 py-3.5 text-lg font-semibold transition-all duration-300 active:scale-[0.98]',
              isActive(item.href) ? 'bg-brand-500/10 text-text' : 'text-muted hover:bg-surface hover:text-text',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <span
              class:list={[
                'inline-flex size-10 shrink-0 items-center justify-center rounded-xl transition-all duration-300',
                isActive(item.href) ? 'icon-tile' : 'bg-surface-2 text-brand-500 group-hover:bg-brand-500/15',
              ]}
            >
              <Icon name={item.icon} size={20} />
            </span>
            {item.label}
            <Icon
              name="ph:arrow-right-bold"
              size={18}
              class="ml-auto opacity-40 transition-all duration-300 group-hover:translate-x-1 group-hover:opacity-100" />
          </a>
        </li>
      ))}
    </ul>

    <div class="mobile-item mt-auto pt-8" style={`--i:${site.nav.length}`}>
      <a href="/contact" class="btn-primary mobile-link w-full !py-3.5 text-base">
        Hire me
        <Icon name="ph:arrow-right-bold" size={16} />
      </a>
      <div class="mt-6 flex items-center justify-between">
        <div class="flex items-center gap-2">
          {site.socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label={s.label}>
              <Icon name={s.icon} size={18} />
            </a>
          ))}
        </div>
        <button type="button" class="icon-btn gap-2 !w-auto px-4 text-sm font-medium" data-theme-toggle aria-label="Toggle dark mode">
          <Icon name="ph:sun-bold" size={18} class="hidden dark:inline-block" />
          <Icon name="ph:moon-bold" size={18} class="dark:hidden" />
          <span class="hidden dark:inline">Light</span><span class="dark:hidden">Dark</span>
        </button>
      </div>
      <p class="mt-6 text-center text-xs text-muted">{site.name} · {site.company.shortName}</p>
    </div>
  </div>
</div>
