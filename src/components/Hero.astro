---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import photo from '../assets/my.png';
---

<section id="home" class="relative flex items-center overflow-hidden pb-12 pt-24 sm:pt-28 lg:min-h-svh lg:pb-16">
  <!-- Background decoration -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="bg-grid absolute inset-0"></div>
    <div
      class="blob absolute -left-40 -top-40 size-[34rem] rounded-full bg-brand-500/25 blur-3xl animate-blob"
      data-parallax="30"
    >
    </div>
    <div
      class="blob absolute -right-40 top-1/4 size-[30rem] rounded-full bg-accent-500/20 blur-3xl animate-blob [animation-delay:-7s]"
      data-parallax="-40"
    >
    </div>
    <div
      class="blob absolute bottom-0 left-1/3 size-[26rem] rounded-full bg-sky-500/15 blur-3xl animate-blob [animation-delay:-12s]"
      data-parallax="20"
    >
    </div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-linear-to-t from-bg to-transparent"></div>
  </div>

  <div class="container-x grid items-center gap-10 lg:grid-cols-[1.05fr_1fr] lg:gap-10">
    <!-- Copy -->
    <div class="order-2 text-center lg:order-1 lg:text-left">
      <span class="eyebrow animate-fade-up">
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
        </span>
        {site.availability}
      </span>

      <p class="mt-5 font-display text-lg font-semibold text-muted animate-fade-up [animation-delay:80ms] sm:mt-6 sm:text-xl">
        {site.hero.greeting} <span class="text-text">{site.shortName}</span> <span class="inline-block origin-[70%_70%] animate-wave" aria-hidden="true">👋</span>
      </p>

      <h1
        class="mt-2 font-display text-[2.4rem] font-extrabold leading-[1.02] tracking-tight animate-fade-up [animation-delay:140ms] sm:text-6xl xl:text-[4.25rem]"
      >
        <span class="block">Nadarajah</span>
        <span class="grad-text block pb-1">Shanmugarajah</span>
      </h1>

      <p class="mt-4 flex flex-wrap items-baseline justify-center gap-x-2 font-display text-lg font-semibold sm:text-2xl animate-fade-up [animation-delay:200ms] lg:justify-start">
        <span class="whitespace-nowrap">Founder &amp; CEO, <a href={site.company.url} target="_blank" rel="noopener" class="underline decoration-brand-500/40 decoration-2 underline-offset-4 transition-colors hover:text-brand-500">{site.company.shortName}</a></span>
        <span class="hidden text-line-strong lg:inline" aria-hidden="true">/</span>
        <span class="whitespace-nowrap text-muted">Software Engineer</span>
      </p>

      <p class="mx-auto mt-3 max-w-xl text-[15px] text-muted animate-fade-up [animation-delay:260ms] sm:text-lg lg:mx-0">
        {site.hero.lead}{' '}
        <span id="typed" class="caret font-semibold text-text" data-roles={JSON.stringify(site.roles)}>{site.roles[0]}</span>
      </p>

      <div
        class="mt-7 flex flex-wrap justify-center gap-3 animate-fade-up [animation-delay:320ms] sm:mt-8 sm:gap-4 lg:justify-start"
      >
        <a href="/work" class="btn-primary">
          View my work
          <Icon name="ph:arrow-right-bold" size={16} />
        </a>
        <a href="/contact" class="btn-ghost">
          <Icon name="ph:paper-plane-tilt-bold" size={16} />
          Get in touch
        </a>
      </div>

      <!-- credentials -->
      <dl
        class="mx-auto mt-8 grid max-w-md grid-cols-3 divide-x divide-line border-y border-line py-4 animate-fade-up [animation-delay:400ms] sm:mt-10 lg:mx-0"
      >
        {site.stats.slice(0, 3).map((s) => (
          <div class="px-2 text-center first:pl-0 lg:text-left lg:[&:not(:first-child)]:pl-5">
            <dt class="sr-only">{s.label}</dt>
            <dd class="font-display text-2xl font-extrabold sm:text-3xl"><span class="grad-text">{s.value}{s.suffix}</span></dd>
            <dd class="mt-0.5 text-[11px] font-medium uppercase tracking-wider text-muted sm:text-xs">{s.label}</dd>
          </div>
        ))}
      </dl>

      <div
        class="mt-6 flex items-center justify-center gap-3 animate-fade-up [animation-delay:460ms] lg:justify-start"
      >
        <span class="text-xs font-medium uppercase tracking-widest text-muted">Connect</span>
        <span class="h-px w-6 bg-line-strong"></span>
        {site.socials.map((s) => (
          <a href={s.href} target="_blank" rel="me noopener" class="icon-btn" aria-label={s.label}>
            <Icon name={s.icon} size={20} />
          </a>
        ))}
      </div>
    </div>

    <!-- Portrait -->
    <div class="order-1 lg:order-2">
      <div class="relative mx-auto mt-6 w-full max-w-[17rem] animate-scale-in [animation-delay:200ms] sm:max-w-lg lg:mt-0 lg:max-w-[33rem] xl:max-w-[35rem]" data-tilt="6">
        <!-- soft glow behind the card -->
        <div
          class="absolute inset-x-4 bottom-4 top-1/3 rounded-[3rem] bg-linear-to-tr from-brand-600 via-brand-400 to-accent-500 opacity-40 blur-3xl animate-pulse-soft dark:opacity-50"
          aria-hidden="true"
        >
        </div>

        <div class="relative aspect-square">
          <!-- gradient card the portrait stands in front of -->
          <div
            class="absolute inset-x-0 bottom-0 top-[18%] overflow-hidden rounded-[2.5rem] bg-linear-to-br from-brand-600 via-brand-500 to-accent-500 bg-[length:200%_200%] shadow-2xl shadow-brand-600/40 animate-gradient-x"
            aria-hidden="true"
          >
            <div class="absolute inset-0 opacity-[0.12] [background-image:linear-gradient(#fff_1px,transparent_1px),linear-gradient(90deg,#fff_1px,transparent_1px)] [background-size:28px_28px]"></div>
            <div class="absolute -right-16 -top-16 size-56 rounded-full bg-white/25 blur-3xl"></div>
            <div class="absolute -bottom-20 -left-16 size-56 rounded-full bg-black/20 blur-3xl"></div>
            <span class="absolute left-6 top-6 font-display text-[5rem] font-extrabold leading-none text-white/10 select-none">R</span>
          </div>

          <!-- portrait: open at the top so the head rises above the card, clipped to the card's rounded base -->
          <div class="absolute inset-x-0 -top-[10%] bottom-0 overflow-hidden rounded-b-[2.5rem]">
            <Image
              src={photo}
              alt={`Portrait of ${site.name}`}
              width={720}
              densities={[1, 2]}
              loading="eager"
              fetchpriority="high"
              class="absolute bottom-0 left-1/2 w-full -translate-x-1/2 object-contain drop-shadow-[0_30px_40px_rgba(0,0,0,0.45)]"
            />
          </div>

          <!-- accents -->
          <span class="absolute -left-2 top-[30%] size-3 rounded-full bg-accent-500 shadow-[0_0_14px_var(--color-accent-500)] animate-float" aria-hidden="true"></span>
          <span class="absolute -right-3 top-[55%] size-2.5 rounded-full bg-brand-400 shadow-[0_0_14px_var(--color-brand-400)] animate-float [animation-delay:-2s]" aria-hidden="true"></span>
        </div>

      </div>
    </div>
  </div>

  <a
    href="#about"
    class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-xs font-medium uppercase tracking-widest text-muted transition-colors hover:text-brand-500 sm:flex"
    aria-label="Scroll to about section"
  >
    Scroll
    <span class="flex h-9 w-5 items-start justify-center rounded-full border border-line-strong p-1">
      <span class="size-1.5 rounded-full bg-brand-500 animate-bounce-soft"></span>
    </span>
  </a>
</section>
