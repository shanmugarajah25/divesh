---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';
import SectionHeading from './SectionHeading.astro';

const marquee = site.skillGroups.flatMap((g) => g.skills);

interface Props {
  heading?: boolean;
}
const { heading = true } = Astro.props;
---

<section id="skills" class="section overflow-hidden">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute left-1/2 top-0 h-px w-2/3 -translate-x-1/2 bg-linear-to-r from-transparent via-brand-500/40 to-transparent"></div>
    <div class="absolute -right-40 top-20 size-[28rem] rounded-full bg-brand-500/10 blur-3xl blob"></div>
  </div>

  <div class="container-x">
    {heading && (
      <SectionHeading
        eyebrow="Skills"
        title="My technical"
        highlight="toolbox"
        description="Technologies I use daily to design, build and ship reliable software."
      />
    )}

    <div class:list={['grid gap-6 md:grid-cols-3', heading ? 'mt-16' : 'mt-4']}>
      {site.skillGroups.map((group, gi) => (
        <div class="reveal card card-hover p-6" style={`--d:${gi * 120}ms`}>
          <div class="flex items-center gap-3">
            <span class="icon-tile size-11">
              <Icon name={group.icon} size={22} />
            </span>
            <h3 class="font-display text-lg font-bold">{group.title}</h3>
          </div>
          <ul class="mt-6 flex flex-wrap gap-2">
            {group.skills.map((s) => (
              <li class="chip">
                <Icon name={s.icon} size={18} />
                {s.name}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <!-- Infinite marquee -->
  <div class="marquee-mask reveal mt-16 w-full overflow-hidden" style="--d:200ms">
    <div class="flex w-max gap-4 animate-marquee hover:[animation-play-state:paused]">
      {[...marquee, ...marquee].map((s) => (
        <div class="card flex items-center gap-3 px-5 py-3 whitespace-nowrap">
          <Icon name={s.icon} size={22} />
          <span class="text-sm font-medium">{s.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>
