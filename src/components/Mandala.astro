---
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const ring = (n: number, r: number, len: number, w: number) =>
  Array.from({ length: n }).map((_, i) => ({ a: (360 / n) * i, r, len, w }));
---
<svg class={`mandala ${cls}`} viewBox="-100 -100 200 200" aria-hidden="true">
  <circle r="96" fill="none" stroke="url(#g-gold)" stroke-width="1.2" stroke-dasharray="2 3" />
  <circle r="88" fill="none" stroke="url(#g-gold)" stroke-width=".8" />
  {ring(24, 70, 18, 5).map((p) => (
    <path transform={`rotate(${p.a})`} d={`M0 -${p.r} q${p.w} -${p.len / 2} 0 -${p.len} q-${p.w} ${p.len / 2} 0 ${p.len}z`} fill="url(#g-gold)" opacity=".55" />
  ))}
  {ring(24, 86, 0, 0).map((p) => (
    <circle transform={`rotate(${p.a + 7.5})`} cy={-p.r} r="1.8" fill="#c8102e" opacity=".55" />
  ))}
  {ring(12, 46, 22, 9).map((p) => (
    <path transform={`rotate(${p.a})`} d={`M0 -${p.r} q${p.w} -${p.len / 2} 0 -${p.len} q-${p.w} ${p.len / 2} 0 ${p.len}z`} fill="none" stroke="url(#g-gold)" stroke-width="1" />
  ))}
  <circle r="44" fill="none" stroke="url(#g-gold)" stroke-width="1" stroke-dasharray="1 2.5" />
  {ring(8, 22, 20, 8).map((p) => (
    <path transform={`rotate(${p.a})`} d={`M0 -${p.r} q${p.w} -${p.len / 2} 0 -${p.len} q-${p.w} ${p.len / 2} 0 ${p.len}z`} fill="url(#g-gold)" opacity=".4" />
  ))}
  <circle r="10" fill="none" stroke="url(#g-gold)" stroke-width="1.2" />
</svg>
