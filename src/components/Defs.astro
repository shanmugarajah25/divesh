---
// Shared SVG gradients used by all ornaments on the page
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="g-gold" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fff1b8" />
      <stop offset=".35" stop-color="#e2b54f" />
      <stop offset=".7" stop-color="#b07d1f" />
      <stop offset="1" stop-color="#f3d27a" />
    </linearGradient>
    <linearGradient id="g-gold-v" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fbe39a" />
      <stop offset=".5" stop-color="#d4a137" />
      <stop offset="1" stop-color="#8f5f12" />
    </linearGradient>
    <radialGradient id="g-flame" cx=".5" cy=".75" r=".7">
      <stop offset="0" stop-color="#fffbe6" />
      <stop offset=".35" stop-color="#ffd54a" />
      <stop offset=".75" stop-color="#ff8a1f" />
      <stop offset="1" stop-color="#e2420d" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="g-eye" cx=".5" cy=".55" r=".5">
      <stop offset="0" stop-color="#0b1d5c" />
      <stop offset=".45" stop-color="#1347b8" />
      <stop offset=".62" stop-color="#1aa3a0" />
      <stop offset=".78" stop-color="#d9b13a" />
      <stop offset="1" stop-color="#2f8f3a" />
    </radialGradient>
  </defs>
</svg>
