---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  heading?: boolean;
  /** Limit the number of questions shown (e.g. on the home page). */
  limit?: number;
}
const { heading = true, limit } = Astro.props;
const faqs = limit ? site.faqs.slice(0, limit) : site.faqs;
---

<section id="faq" class="section">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute left-1/2 top-0 h-px w-2/3 -translate-x-1/2 bg-linear-to-r from-transparent via-brand-500/40 to-transparent"></div>
    <div class="blob absolute -left-40 top-1/2 size-[26rem] -translate-y-1/2 rounded-full bg-brand-500/10 blur-3xl"></div>
  </div>

  <div class="container-x">
    {heading && (
      <SectionHeading
        eyebrow="FAQ"
        title="Frequently asked"
        highlight="questions"
        description="Quick answers about working with me and Loncey Tech."
      />
    )}

    <div class:list={['mx-auto max-w-3xl space-y-3', heading ? 'mt-16' : 'mt-4']}>
      {faqs.map((f, i) => (
        <details class="faq reveal card group overflow-hidden" style={`--d:${i * 60}ms`} name="faq">
          <summary class="flex cursor-pointer list-none items-center gap-4 px-5 py-4 sm:px-6 sm:py-5 [&::-webkit-details-marker]:hidden">
            <span class="icon-tile size-9 shrink-0 rounded-lg text-sm">
              <Icon name={f.icon} size={18} />
            </span>
            <span class="flex-1 font-display text-base font-semibold sm:text-lg">{f.q}</span>
            <span class="faq-chevron inline-flex size-8 shrink-0 items-center justify-center rounded-full border border-line text-muted transition-all duration-300 group-open:rotate-180 group-open:border-brand-500/50 group-open:bg-brand-500/10 group-open:text-brand-500">
              <Icon name="ph:caret-down-bold" size={14} />
            </span>
          </summary>
          <div class="faq-body">
            <div>
              <p class="border-t border-line px-5 pb-5 pt-4 text-sm leading-relaxed text-muted sm:px-6 sm:pl-[4.75rem] sm:text-base">
                {f.a}
              </p>
            </div>
          </div>
        </details>
      ))}
    </div>

    {limit && limit < site.faqs.length && (
      <div class="reveal mt-10 text-center" style="--d:200ms">
        <a href="/faq" class="btn-ghost">
          See all questions
          <Icon name="ph:arrow-right-bold" size={16} />
        </a>
      </div>
    )}
  </div>
</section>
