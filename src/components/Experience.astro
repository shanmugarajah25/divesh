---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  heading?: boolean;
}
const { heading = true } = Astro.props;
---

<section id="experience" class="section">
  <div class="container-x">
    {heading && (
      <SectionHeading
        eyebrow="Experience"
        title="My professional"
        highlight="journey"
        description="From web developer to founder: the roles and milestones that shaped how I build software and lead teams."
      />
    )}

    <div class:list={['relative mx-auto max-w-4xl', heading ? 'mt-16' : 'mt-4']}>
      <!-- vertical line -->
      <div
        class="absolute bottom-0 left-5 top-0 w-px bg-linear-to-b from-transparent via-brand-500/50 to-transparent md:left-1/2 md:-translate-x-1/2"
        aria-hidden="true"
      >
      </div>

      <ol class="space-y-10">
        {site.experience.map((item, i) => {
          const left = i % 2 === 0;
          return (
            <li class="relative pl-12 md:grid md:grid-cols-2 md:gap-12 md:pl-0">
              <!-- dot -->
              <span
                class="absolute left-5 top-6 flex size-4 -translate-x-1/2 items-center justify-center md:left-1/2"
                aria-hidden="true"
              >
                <span class="absolute inline-flex size-full animate-ping rounded-full bg-brand-500/40"></span>
                <span class="relative inline-flex size-3 rounded-full bg-linear-to-r from-brand-500 to-accent-500 ring-4 ring-bg"></span>
              </span>

              <div class:list={['reveal', left ? 'md:col-start-1' : 'md:col-start-2']} data-reveal={left ? 'left' : 'right'} style={`--d:${i * 60}ms`}>
                <div class="card card-hover p-5 sm:p-6">
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <span class="eyebrow">{item.period}</span>
                    <span class="inline-flex size-9 items-center justify-center rounded-lg bg-brand-500/10 text-brand-500">
                      <Icon name={item.icon} size={18} />
                    </span>
                  </div>
                  <h3 class="mt-4 font-display text-lg font-bold">{item.role}</h3>
                  <p class="text-sm font-medium text-brand-500">{item.company}</p>
                  <p class="mt-3 text-sm leading-relaxed text-muted">{item.text}</p>
                  <ul class="mt-4 flex flex-wrap gap-2">
                    {item.tags.map((t) => (
                      <li class="rounded-full bg-surface-2 px-2.5 py-1 text-xs font-medium text-muted">{t}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>

    <!-- Education -->
    <div class="mx-auto mt-20 max-w-4xl">
      <h3 class="reveal text-center font-display text-2xl font-bold tracking-tight sm:text-3xl">
        Education & <span class="grad-text">certifications</span>
      </h3>
      <div class="mt-8 grid gap-5 sm:grid-cols-2">
        {site.education.map((e, i) => (
          <div class="reveal card card-hover flex gap-4 p-6" style={`--d:${i * 100}ms`}>
            <span class="icon-tile size-12">
              <Icon name={e.icon} size={24} />
            </span>
            <div>
              <span class="text-xs font-semibold uppercase tracking-wider text-brand-500">{e.period}</span>
              <p class="mt-1 font-display font-bold">{e.degree}</p>
              <p class="text-sm text-muted">{e.school}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
